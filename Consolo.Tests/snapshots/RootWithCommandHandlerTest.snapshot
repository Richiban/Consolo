using System;
using System.Linq;
using System.Collections.Generic;
using System.Collections.Immutable;

namespace Consolo.TestSource.g
{
    /// <summary>
    /// Entrypoint class for Consolo.TestSource
    /// </summary>
    public static class Program
    {
        /// <summary>
        /// Entrypoint for Consolo.TestSource
        /// </summary>
        public static void Main(string[] args)
        {
            var consoleColor = Console.ForegroundColor;
            var helpTextColor = ConsoleColor.Green;
            var commandNameColor = ConsoleColor.Yellow;

            // Commands marked * have an associated method
            // {root} command*
                // --version command*

            if (args.Any(arg => arg.StartsWith(' ') && ! arg.StartsWith("--")))
            {
                args = args.SelectMany(arg => arg.StartsWith(' ') && ! arg.StartsWith("--") ? arg.Skip(1).Select(c => $"-{c}") : new [] { arg }).ToArray();
            }

            var isHelp = args.Any(arg => arg == "--help" || arg == "-h" || arg == "-?");

            {
                if (args.Length >= 1 && args[0] == "--version")
                {
                    if (!isHelp)
                    {
                        var unclaimedArgs = new UnclaimedArgs(args.Length, 1);
                        var processingError = false;

                        if (unclaimedArgs.Any)
                        {
                            Console.ForegroundColor = ConsoleColor.Red;
                            Console.Error.WriteLine($"Unrecognised args: " + unclaimedArgs.Describe(args) + "");
                            Console.ForegroundColor = consoleColor;
                            processingError = true;
                        }

                        if (!processingError)
                        {
                            PrintVersion();
                            return;
                        }
                    }

                    Console.WriteLine("Consolo.TestSource");
                    Console.WriteLine();
                    Console.ForegroundColor = commandNameColor;
                    Console.WriteLine("--version");
                    Console.ForegroundColor = consoleColor;
                    Console.ForegroundColor = helpTextColor;
                    Console.WriteLine("    Prints the version of the application");
                    Console.WriteLine();
                    Console.ForegroundColor = consoleColor;
                    Console.WriteLine("Usage:");
                    Console.WriteLine($"    --version [options]");
                    Console.WriteLine();
                    Console.WriteLine("Options:");
                    Console.Write("    -?, -h, --help  ");
                    Console.ForegroundColor = helpTextColor;
                    Console.WriteLine("Show help and usage information");
                    Console.ForegroundColor = consoleColor;
                    Console.WriteLine();
                    return;
                }
                if (!isHelp)
                {
                    var unclaimedArgs = new UnclaimedArgs(args.Length, 0);
                    var processingError = false;

                    if (unclaimedArgs.Any)
                    {
                        Console.ForegroundColor = ConsoleColor.Red;
                        Console.Error.WriteLine($"Unrecognised args: " + unclaimedArgs.Describe(args) + "");
                        Console.ForegroundColor = consoleColor;
                        processingError = true;
                    }

                    if (!processingError)
                    {
                        TestSamples.RootContainer.RootMethod();
                        return;
                    }
                }

                Console.WriteLine("Consolo.TestSource");
                Console.ForegroundColor = helpTextColor;
                Console.WriteLine();
                Console.ForegroundColor = consoleColor;
                Console.WriteLine("Usage:");
                Console.WriteLine($"     [options]");
                Console.WriteLine();
                Console.WriteLine("Options:");
                Console.Write("    -?, -h, --help  ");
                Console.ForegroundColor = helpTextColor;
                Console.WriteLine("Show help and usage information");
                Console.ForegroundColor = consoleColor;
                Console.WriteLine();
                Console.WriteLine("Commands:");
                return;
            }
        }

                #pragma warning disable CS8321
        // Tracks unclaimed argument indexes. Up to 64 arguments are held in a ulong bit mask
        // (a set bit means unclaimed); longer invocations fall back to a bool[].
        private struct UnclaimedArgs
        {
            private ulong _mask;
            private readonly bool[] _flags;

            public UnclaimedArgs(int length, int start)
            {
                Length = length;
                _mask = 0;
                _flags = Array.Empty<bool>();

                if (length <= 64)
                {
                    if (start < length)
                    {
                        var count = length - start;
                        var bits = count == 64 ? ulong.MaxValue : (1UL << count) - 1;
                        _mask = bits << start;
                    }
                }
                else
                {
                    _flags = new bool[length];

                    for (var i = start; i < length; i++)
                    {
                        _flags[i] = true;
                    }
                }
            }

            public int Length { get; }

            public bool this[int index] =>
                index >= 0 && index < Length
                && (Length <= 64 ? (_mask & (1UL << index)) != 0 : _flags[index]);

            public bool Any => Length <= 64 ? _mask != 0 : Array.IndexOf(_flags, true) >= 0;

            public void Clear(int index)
            {
                if (Length <= 64)
                {
                    _mask &= ~(1UL << index);
                }
                else
                {
                    _flags[index] = false;
                }
            }

            public string Describe(string[] args)
            {
                var unclaimed = new List<string>();

                for (var i = 0; i < Length; i++)
                {
                    if (this[i])
                    {
                        unclaimed.Add(args[i]);
                    }
                }

                return string.Join(", ", unclaimed);
            }
        }

        static bool MatchNextPositional<T>(string[] args, ref T value, Func<string, T> mapper, ref UnclaimedArgs unclaimedArgs)
        {
            for (var index = 0; index < unclaimedArgs.Length; index++)
            {
                if (!unclaimedArgs[index]) continue;
                var arg = args[index];
                if (!arg.StartsWith("-"))
                {
                    value = mapper(arg);
                    unclaimedArgs.Clear(index);
                    return true;
                }
            }

            return false;
        }

        static bool MatchNextFlag(string[] args, string[] optionNames, ref bool value, ref UnclaimedArgs unclaimedArgs)
        {
            for (var index = 0; index < unclaimedArgs.Length; index++)
            {
                if (!unclaimedArgs[index]) continue;
                var arg = args[index];
            
                if (arg.EndsWith(":true", StringComparison.InvariantCultureIgnoreCase) || arg.EndsWith("=true", StringComparison.InvariantCultureIgnoreCase))
                {
                    var optionName = arg.Substring(0, arg.Length - 5);

                    if (optionNames.Contains(optionName))
                    {
                        value = true;
                        unclaimedArgs.Clear(index);
                        return true;
                    }
                }
            
                if (arg.EndsWith(":false", StringComparison.InvariantCultureIgnoreCase) || arg.EndsWith("=false", StringComparison.InvariantCultureIgnoreCase))
                {
                    var optionName = arg.Substring(0, arg.Length - 6);

                    if (optionNames.Contains(optionName))
                    {
                        value = false;
                        unclaimedArgs.Clear(index);
                        return true;
                    }
                }

                if (optionNames.Contains(arg))
                {
                    value = true;
                    unclaimedArgs.Clear(index);
                    return true;
                }
            }

            return false;
        }

        // Returns 0 if the option is not found
        // Returns 1 if the option is found and the value is found
        // Returns 2 if the option is found but the value is missing
        static int MatchNextOption<T>(string[] args, string[] optionNames, ref T value, Func<string, T> mapper, ref UnclaimedArgs unclaimedArgs)
        {
            for (var i = 0; i < unclaimedArgs.Length; i++)
            {
                if (!unclaimedArgs[i]) continue;
                var arg = args[i];

                if (optionNames.Contains(arg))
                {
                    if (i + 1 < args.Length && unclaimedArgs[i + 1] && !args[i + 1].StartsWith("-"))
                    {
                        value = mapper(args[i + 1]);
                        unclaimedArgs.Clear(i);
                        unclaimedArgs.Clear(i + 1);
                        return 1;
                    }
                    
                    return 2;
                }

                if (arg.Contains(':'))
                {
                    var parts = arg.Split(':', 2);

                    if (optionNames.Contains(parts[0]))
                    {
                        value = mapper(parts[1]);
                        unclaimedArgs.Clear(i);
                        return 1;
                    }
                }

                if (arg.Contains('='))
                {
                    var parts = arg.Split('=', 2);

                    if (optionNames.Contains(parts[0]))
                    {
                        value = mapper(parts[1]);
                        unclaimedArgs.Clear(i);
                        return 1;
                    }
                }

            }

            return 0;
        }
        
        #pragma warning restore CS8321
        static void PrintVersion()
{
    Console.WriteLine(System.Reflection.Assembly.GetExecutingAssembly().GetName().Version?.ToString());
}
    }
}
