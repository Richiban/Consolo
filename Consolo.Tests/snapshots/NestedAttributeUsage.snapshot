using System;
using System.Collections.Generic;
using System.Collections.Immutable;

namespace Consolo.TestSource.g
{
    /// <summary>
    /// Entrypoint class for Consolo.TestSource
    /// </summary>
    public static class Program
    {
        /// <summary>
        /// Entrypoint for Consolo.TestSource
        /// </summary>
        public static int Main(string[] args)
        {
            var exitCode = 0;
            var consoleColor = Console.ForegroundColor;
            var helpTextColor = ConsoleColor.Green;
            var commandNameColor = ConsoleColor.Yellow;

            // Commands marked * have an associated method
            // {root} command
                // outer-test command
                    // inner-test1 command
                        // test-method1 command*
                        // test-method2 command*
                    // inner-test2 command
                        // test-method3 command*
                // --version command*

            var normalizeArgs = false;
            for (var i = 0; i < args.Length; i++)
            {
                if (args[i].StartsWith(' ') && !args[i].StartsWith("--"))
                {
                    normalizeArgs = true;
                    break;
                }
            }
            if (normalizeArgs)
            {
                var normalizedArgs = new List<string>();
                for (var i = 0; i < args.Length; i++)
                {
                    var arg = args[i];
                    if (arg.StartsWith(' ') && !arg.StartsWith("--"))
                    {
                        for (var j = 1; j < arg.Length; j++)
                        {
                            normalizedArgs.Add($"-{arg[j]}");
                        }
                    }
                    else
                    {
                        normalizedArgs.Add(arg);
                    }
                }
                args = normalizedArgs.ToArray();
            }

            var isHelp = false;
            for (var i = args.Length - 1; i >= 0; i--)
            {
                if (args[i] == "--help" || args[i] == "-h" || args[i] == "-?")
                {
                    isHelp = true;
                    break;
                }
            }

            {
                if (args.Length >= 1 && args[0] == "outer-test")
                {
                    if (args.Length >= 2 && args[1] == "inner-test1")
                    {
                        if (args.Length >= 3 && args[2] == "test-method1")
                        {
                            if (!isHelp)
                            {
                                var unclaimedArgs = new UnclaimedArgs(args.Length, 3);
                                var processingError = false;

                                if (unclaimedArgs.Any)
                                {
                                    exitCode = 1;
                                    Console.ForegroundColor = ConsoleColor.Red;
                                    Console.Error.WriteLine($"Unrecognised args: " + unclaimedArgs.Describe(args) + "");
                                    Console.ForegroundColor = consoleColor;
                                    processingError = true;
                                }

                                if (!processingError)
                                {
                                    TestSamples.OuterTest.InnerTest1.TestMethod1();
                                    return exitCode;
                                }
                            }

                            Console.WriteLine("Consolo.TestSource");
                            Console.WriteLine();
                            Console.ForegroundColor = commandNameColor;
                            Console.WriteLine("test-method1");
                            Console.ForegroundColor = consoleColor;
                            Console.ForegroundColor = helpTextColor;
                            Console.WriteLine();
                            Console.ForegroundColor = consoleColor;
                            Console.WriteLine("Usage:");
                            Console.WriteLine($"    outer-test inner-test1 test-method1 [options]");
                            Console.WriteLine();
                            Console.WriteLine("Options:");
                            Console.Write("    -?, -h, --help  ");
                            Console.ForegroundColor = helpTextColor;
                            Console.WriteLine("Show help and usage information");
                            Console.ForegroundColor = consoleColor;
                            Console.WriteLine();
                            return exitCode;
                        }
                        if (args.Length >= 3 && args[2] == "test-method2")
                        {
                            if (!isHelp)
                            {
                                var unclaimedArgs = new UnclaimedArgs(args.Length, 3);
                                var processingError = false;

                                var arg1 = default(System.String);
                                if (!MatchNextPositional(args, ref arg1, s => s, ref unclaimedArgs))
                                {
                                    exitCode = 1;
                                    Console.ForegroundColor = ConsoleColor.Red;
                                    Console.Error.WriteLine($"Missing value for argument 'arg1'");
                                    Console.ForegroundColor = consoleColor;
                                    processingError = true;
                                }

                                var arg2 = default(System.String);
                                if (!MatchNextPositional(args, ref arg2, s => s, ref unclaimedArgs))
                                {
                                    exitCode = 1;
                                    Console.ForegroundColor = ConsoleColor.Red;
                                    Console.Error.WriteLine($"Missing value for argument 'arg2'");
                                    Console.ForegroundColor = consoleColor;
                                    processingError = true;
                                }

                                if (unclaimedArgs.Any)
                                {
                                    exitCode = 1;
                                    Console.ForegroundColor = ConsoleColor.Red;
                                    Console.Error.WriteLine($"Unrecognised args: " + unclaimedArgs.Describe(args) + "");
                                    Console.ForegroundColor = consoleColor;
                                    processingError = true;
                                }

                                if (!processingError)
                                {
                                    TestSamples.OuterTest.InnerTest1.TestMethod2(arg1, arg2);
                                    return exitCode;
                                }
                            }

                            Console.WriteLine("Consolo.TestSource");
                            Console.WriteLine();
                            Console.ForegroundColor = commandNameColor;
                            Console.WriteLine("test-method2");
                            Console.ForegroundColor = consoleColor;
                            Console.ForegroundColor = helpTextColor;
                            Console.WriteLine();
                            Console.ForegroundColor = consoleColor;
                            Console.WriteLine("Usage:");
                            Console.WriteLine($"    outer-test inner-test1 test-method2 <arg1> <arg2> [options]");
                            Console.WriteLine();
                            Console.WriteLine("Parameters:");
                            Console.Write("    arg1  ");
                            Console.ForegroundColor = helpTextColor;
                            Console.WriteLine("String");
                            Console.ForegroundColor = consoleColor;
                            Console.Write("    arg2  ");
                            Console.ForegroundColor = helpTextColor;
                            Console.WriteLine("String");
                            Console.ForegroundColor = consoleColor;
                            Console.WriteLine();
                            Console.WriteLine("Options:");
                            Console.Write("    -?, -h, --help  ");
                            Console.ForegroundColor = helpTextColor;
                            Console.WriteLine("Show help and usage information");
                            Console.ForegroundColor = consoleColor;
                            Console.WriteLine();
                            return exitCode;
                        }
                        if (!isHelp)
                        {
                            if (args.Length == 2)
                            {
                                exitCode = 1;
                                Console.ForegroundColor = ConsoleColor.Red;
                                Console.Error.WriteLine($"Missing command after: " + string.Join(" ", args, 1, args.Length - 1) + "");
                                Console.ForegroundColor = consoleColor;
                            }
                            else
                            {
                                exitCode = 1;
                                Console.ForegroundColor = ConsoleColor.Red;
                                Console.Error.WriteLine($"Unknown command: " + string.Join(" ", args, 2, args.Length - 2) + "");
                                Console.ForegroundColor = consoleColor;
                            }
                        }

                        Console.WriteLine("Consolo.TestSource");
                        Console.WriteLine();
                        Console.ForegroundColor = commandNameColor;
                        Console.WriteLine("inner-test1");
                        Console.ForegroundColor = consoleColor;
                        Console.WriteLine("Commands:");
                        Console.Write("    test-method1               ");
                        Console.ForegroundColor = helpTextColor;
                        Console.WriteLine("  ");
                        Console.ForegroundColor = consoleColor;
                        Console.Write("    test-method2 <arg1> <arg2> ");
                        Console.ForegroundColor = helpTextColor;
                        Console.WriteLine("  ");
                        Console.ForegroundColor = consoleColor;
                        return exitCode;
                    }
                    if (args.Length >= 2 && args[1] == "inner-test2")
                    {
                        if (args.Length >= 3 && args[2] == "test-method3")
                        {
                            if (!isHelp)
                            {
                                var unclaimedArgs = new UnclaimedArgs(args.Length, 3);
                                var processingError = false;

                                if (unclaimedArgs.Any)
                                {
                                    exitCode = 1;
                                    Console.ForegroundColor = ConsoleColor.Red;
                                    Console.Error.WriteLine($"Unrecognised args: " + unclaimedArgs.Describe(args) + "");
                                    Console.ForegroundColor = consoleColor;
                                    processingError = true;
                                }

                                if (!processingError)
                                {
                                    TestSamples.OuterTest.InnerTest2.TestMethod3();
                                    return exitCode;
                                }
                            }

                            Console.WriteLine("Consolo.TestSource");
                            Console.WriteLine();
                            Console.ForegroundColor = commandNameColor;
                            Console.WriteLine("test-method3");
                            Console.ForegroundColor = consoleColor;
                            Console.ForegroundColor = helpTextColor;
                            Console.WriteLine();
                            Console.ForegroundColor = consoleColor;
                            Console.WriteLine("Usage:");
                            Console.WriteLine($"    outer-test inner-test2 test-method3 [options]");
                            Console.WriteLine();
                            Console.WriteLine("Options:");
                            Console.Write("    -?, -h, --help  ");
                            Console.ForegroundColor = helpTextColor;
                            Console.WriteLine("Show help and usage information");
                            Console.ForegroundColor = consoleColor;
                            Console.WriteLine();
                            return exitCode;
                        }
                        if (!isHelp)
                        {
                            if (args.Length == 2)
                            {
                                exitCode = 1;
                                Console.ForegroundColor = ConsoleColor.Red;
                                Console.Error.WriteLine($"Missing command after: " + string.Join(" ", args, 1, args.Length - 1) + "");
                                Console.ForegroundColor = consoleColor;
                            }
                            else
                            {
                                exitCode = 1;
                                Console.ForegroundColor = ConsoleColor.Red;
                                Console.Error.WriteLine($"Unknown command: " + string.Join(" ", args, 2, args.Length - 2) + "");
                                Console.ForegroundColor = consoleColor;
                            }
                        }

                        Console.WriteLine("Consolo.TestSource");
                        Console.WriteLine();
                        Console.ForegroundColor = commandNameColor;
                        Console.WriteLine("inner-test2");
                        Console.ForegroundColor = consoleColor;
                        Console.WriteLine("Commands:");
                        Console.Write("    test-method3 ");
                        Console.ForegroundColor = helpTextColor;
                        Console.WriteLine("  ");
                        Console.ForegroundColor = consoleColor;
                        return exitCode;
                    }
                    if (!isHelp)
                    {
                        if (args.Length == 1)
                        {
                            exitCode = 1;
                            Console.ForegroundColor = ConsoleColor.Red;
                            Console.Error.WriteLine($"Missing command after: " + string.Join(" ", args, 0, args.Length - 0) + "");
                            Console.ForegroundColor = consoleColor;
                        }
                        else
                        {
                            exitCode = 1;
                            Console.ForegroundColor = ConsoleColor.Red;
                            Console.Error.WriteLine($"Unknown command: " + string.Join(" ", args, 1, args.Length - 1) + "");
                            Console.ForegroundColor = consoleColor;
                        }
                    }

                    Console.WriteLine("Consolo.TestSource");
                    Console.WriteLine();
                    Console.ForegroundColor = commandNameColor;
                    Console.WriteLine("outer-test");
                    Console.ForegroundColor = consoleColor;
                    Console.WriteLine("Commands:");
                    Console.Write("    inner-test1 ..");
                    Console.ForegroundColor = helpTextColor;
                    Console.WriteLine("  ");
                    Console.ForegroundColor = consoleColor;
                    Console.Write("    inner-test2 ..");
                    Console.ForegroundColor = helpTextColor;
                    Console.WriteLine("  ");
                    Console.ForegroundColor = consoleColor;
                    return exitCode;
                }
                if (args.Length >= 1 && args[0] == "--version")
                {
                    if (!isHelp)
                    {
                        var unclaimedArgs = new UnclaimedArgs(args.Length, 1);
                        var processingError = false;

                        if (unclaimedArgs.Any)
                        {
                            exitCode = 1;
                            Console.ForegroundColor = ConsoleColor.Red;
                            Console.Error.WriteLine($"Unrecognised args: " + unclaimedArgs.Describe(args) + "");
                            Console.ForegroundColor = consoleColor;
                            processingError = true;
                        }

                        if (!processingError)
                        {
                            PrintVersion();
                            return exitCode;
                        }
                    }

                    Console.WriteLine("Consolo.TestSource");
                    Console.WriteLine();
                    Console.ForegroundColor = commandNameColor;
                    Console.WriteLine("--version");
                    Console.ForegroundColor = consoleColor;
                    Console.ForegroundColor = helpTextColor;
                    Console.WriteLine("    Prints the version of the application");
                    Console.WriteLine();
                    Console.ForegroundColor = consoleColor;
                    Console.WriteLine("Usage:");
                    Console.WriteLine($"    --version [options]");
                    Console.WriteLine();
                    Console.WriteLine("Options:");
                    Console.Write("    -?, -h, --help  ");
                    Console.ForegroundColor = helpTextColor;
                    Console.WriteLine("Show help and usage information");
                    Console.ForegroundColor = consoleColor;
                    Console.WriteLine();
                    return exitCode;
                }
                if (!isHelp)
                {
                    if (args.Length == 0)
                    {
                        exitCode = 1;
                        Console.ForegroundColor = ConsoleColor.Red;
                        Console.Error.WriteLine($"Missing command");
                        Console.ForegroundColor = consoleColor;
                    }
                    else
                    {
                        exitCode = 1;
                        Console.ForegroundColor = ConsoleColor.Red;
                        Console.Error.WriteLine($"Unknown command: " + string.Join(" ", args, 0, args.Length - 0) + "");
                        Console.ForegroundColor = consoleColor;
                    }
                }

                Console.WriteLine("Consolo.TestSource");
                Console.WriteLine("Commands:");
                Console.Write("    outer-test ..");
                Console.ForegroundColor = helpTextColor;
                Console.WriteLine("  ");
                Console.ForegroundColor = consoleColor;
                return exitCode;
            }
        }

                #pragma warning disable CS8321
        // Tracks unclaimed argument indexes. Up to 64 arguments are held in a ulong bit mask
        // (a set bit means unclaimed); longer invocations fall back to a bool[].
        private struct UnclaimedArgs
        {
            private ulong _mask;
            private readonly bool[] _flags;

            public UnclaimedArgs(int length, int start)
            {
                Length = length;
                _mask = 0;
                _flags = Array.Empty<bool>();

                if (length <= 64)
                {
                    if (start < length)
                    {
                        var count = length - start;
                        var bits = count == 64 ? ulong.MaxValue : (1UL << count) - 1;
                        _mask = bits << start;
                    }
                }
                else
                {
                    _flags = new bool[length];

                    for (var i = start; i < length; i++)
                    {
                        _flags[i] = true;
                    }
                }
            }

            public int Length { get; }

            public bool this[int index] =>
                index >= 0 && index < Length
                && (Length <= 64 ? (_mask & (1UL << index)) != 0 : _flags[index]);

            public bool Any => Length <= 64 ? _mask != 0 : Array.IndexOf(_flags, true) >= 0;

            public void Clear(int index)
            {
                if (Length <= 64)
                {
                    _mask &= ~(1UL << index);
                }
                else
                {
                    _flags[index] = false;
                }
            }

            public string Describe(string[] args)
            {
                var unclaimed = new List<string>();

                for (var i = 0; i < Length; i++)
                {
                    if (this[i])
                    {
                        unclaimed.Add(args[i]);
                    }
                }

                return string.Join(", ", unclaimed);
            }
        }

        static bool MatchNextPositional<T>(string[] args, ref T value, Func<string, T> mapper, ref UnclaimedArgs unclaimedArgs)
        {
            for (var index = 0; index < unclaimedArgs.Length; index++)
            {
                if (!unclaimedArgs[index]) continue;
                var arg = args[index];
                if (!arg.StartsWith("-"))
                {
                    value = mapper(arg);
                    unclaimedArgs.Clear(index);
                    return true;
                }
            }

            return false;
        }

        static bool MatchNextFlag(string[] args, string optionName, string optionAlias, ref bool value, ref UnclaimedArgs unclaimedArgs)
        {
            for (var index = 0; index < unclaimedArgs.Length; index++)
            {
                if (!unclaimedArgs[index]) continue;
                var arg = args[index];
            
                if (arg.EndsWith(":true", StringComparison.InvariantCultureIgnoreCase) || arg.EndsWith("=true", StringComparison.InvariantCultureIgnoreCase))
                {
                    var argOptionName = arg.Substring(0, arg.Length - 5);

                    if (optionName == argOptionName || optionAlias.Length > 0 && optionAlias == argOptionName)
                    {
                        value = true;
                        unclaimedArgs.Clear(index);
                        return true;
                    }
                }
            
                if (arg.EndsWith(":false", StringComparison.InvariantCultureIgnoreCase) || arg.EndsWith("=false", StringComparison.InvariantCultureIgnoreCase))
                {
                    var argOptionName = arg.Substring(0, arg.Length - 6);

                    if (optionName == argOptionName || optionAlias.Length > 0 && optionAlias == argOptionName)
                    {
                        value = false;
                        unclaimedArgs.Clear(index);
                        return true;
                    }
                }

                if (optionName == arg || optionAlias.Length > 0 && optionAlias == arg)
                {
                    value = true;
                    unclaimedArgs.Clear(index);
                    return true;
                }
            }

            return false;
        }

        // Returns 0 if the option is not found
        // Returns 1 if the option is found and the value is found
        // Returns 2 if the option is found but the value is missing
        static int MatchNextOption<T>(string[] args, string optionName, string optionAlias, ref T value, Func<string, T> mapper, ref UnclaimedArgs unclaimedArgs)
        {
            for (var i = 0; i < unclaimedArgs.Length; i++)
            {
                if (!unclaimedArgs[i]) continue;
                var arg = args[i];

                if (optionName == arg || optionAlias.Length > 0 && optionAlias == arg)
                {
                    if (i + 1 < args.Length && unclaimedArgs[i + 1] && !args[i + 1].StartsWith("-"))
                    {
                        value = mapper(args[i + 1]);
                        unclaimedArgs.Clear(i);
                        unclaimedArgs.Clear(i + 1);
                        return 1;
                    }
                    
                    return 2;
                }

                var colonIndex = arg.IndexOf(':');

                if (colonIndex >= 0 && IsOptionName(optionName, optionAlias, arg, colonIndex))
                {
                    value = mapper(arg.Substring(colonIndex + 1));
                    unclaimedArgs.Clear(i);
                    return 1;
                }

                var equalsIndex = arg.IndexOf('=');

                if (equalsIndex >= 0 && IsOptionName(optionName, optionAlias, arg, equalsIndex))
                {
                    value = mapper(arg.Substring(equalsIndex + 1));
                    unclaimedArgs.Clear(i);
                    return 1;
                }
            }

            return 0;
        }

        static bool IsOptionName(string optionName, string optionAlias, string arg, int nameLength)
        {
            return (optionName.Length == nameLength && string.CompareOrdinal(arg, 0, optionName, 0, nameLength) == 0)
                || (optionAlias.Length > 0 && optionAlias.Length == nameLength && string.CompareOrdinal(arg, 0, optionAlias, 0, nameLength) == 0);
        }
        
        #pragma warning restore CS8321
        static void PrintVersion()
{
    Console.WriteLine(System.Reflection.Assembly.GetExecutingAssembly().GetName().Version?.ToString());
}
    }
}
